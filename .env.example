# ──────────────────────────────────────────────
# CopyDTC — required environment variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# (Flask / portal — only needed if running the web app)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=hello@copydtc.com
# ADMIN_EMAIL=you@copydtc.com
# APP_BASE_URL=https://copydtc.com
# SECRET_KEY=change_this_to_a_random_string

# Gmail SMTP for contact form notifications
# GMAIL_USER=bradley.bieselin@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password_here
# CONTACT_EMAIL=bradley.bieselin@gmail.com
